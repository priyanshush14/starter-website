# BridgeTech Website Starter Kit Environment Variables
# Copy this file to .env and fill in your values. Never commit actual secret keys.

# Application URL
VITE_SITE_URL=http://localhost:5173

# Active Industry Preset (agency | local-business | professional)
VITE_DEFAULT_PRESET=agency

# Contact Form Delivery Configuration
# Provider options: "mock" (default, simulates network request), "formspree", "web3forms", or "custom"
VITE_CONTACT_FORM_PROVIDER=mock
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id

# Optional Analytics Integration (disabled by default)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Optional Booking Embed URL (e.g. Calendly, SavvyCal)
VITE_BOOKING_CALENDLY_URL=https://calendly.com/your-business/30min
